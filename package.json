{
  "name": "esl-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5002",
    "build": "next build",
    "start": "next start -p 5002",
    "lint": "eslint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:all": "eslint && stylelint \"src/**/*.css\"",
    "check": "eslint && stylelint \"src/**/*.css\" && tsc --noEmit && vitest run",
    "test": "vitest run",
    "cms:push": "optimizely-cms-cli config push --force",
    "cms:push:local": "node --env-file=.env ./node_modules/@optimizely/cms-cli/bin/run.js config push --force",
    "cms:push:vercel": "node --env-file=.env.vercel ./node_modules/@optimizely/cms-cli/bin/run.js config push --force"
  },
  "dependencies": {
    "@optimizely/cms-sdk": "^2.2.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-vitals": "^6.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@optimizely/cms-cli": "^2.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "critters": "^0.0.25",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
